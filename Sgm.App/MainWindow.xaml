<ui:FluentWindow x:Class="Sgm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Sgm.App.Views"
        xmlns:vm="clr-namespace:Sgm.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Steam Games Manager"
        Width="1120" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        Background="{DynamicResource BgBrush}"
        ExtendsContentIntoTitleBar="True"
        FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <ui:TitleBar Grid.Row="0" Title="Steam Games Manager"
                     Background="{DynamicResource SidebarBrush}"
                     Icon="{ui:SymbolIcon Games24}"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True"
                     CanMaximize="True">
            <ui:TitleBar.TrailingContent>
                <ui:Button Style="{StaticResource SgmGhostButton}" Padding="6,4" Margin="0,0,8,0"
                           Command="{Binding ToggleThemeCommand}"
                           ToolTip="Switch between Steam and Dark Gray themes">
                    <ui:SymbolIcon Symbol="DarkTheme24" FontSize="14" />
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- ============ Navigation shell ============ -->
        <!-- WPF UI's left-pane template leaves the pane transparent and ignores the
             NavigationView background, so paint the sidebar surface behind it. -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}">
            <ui:NavigationView x:Name="NavView"
                               PaneDisplayMode="Left"
                               IsPaneOpen="True"
                               OpenPaneLength="140"
                               CompactPaneLength="0"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="False"
                               IsTopSeparatorVisible="False"
                               IsFooterSeparatorVisible="False"
                               PaneTitle=""
                               BorderThickness="0">
                <ui:NavigationView.Resources>
                    <!-- Keep the app palette for WPF-UI's navigation surface. -->
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{DynamicResource PanelHoverColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{DynamicResource PanelHoverColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{DynamicResource CardColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{DynamicResource MutedColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{DynamicResource TextStrongColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{DynamicResource TextStrongColor}" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{DynamicResource AccentColor}" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{DynamicResource AccentColor}" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{DynamicResource BgColor}" />
                </ui:NavigationView.Resources>

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Library" Icon="{ui:SymbolIcon Grid24}"
                                           TargetPageType="{x:Type views:LibraryView}" />
                    <ui:NavigationViewItem Content="Accounts" Icon="{ui:SymbolIcon Person24}"
                                           TargetPageType="{x:Type views:AccountsView}" />
                    <ui:NavigationViewItem Content="Settings" Icon="{ui:SymbolIcon Settings24}"
                                           TargetPageType="{x:Type views:SettingsView}" />
                    <ui:NavigationViewItem Content="Help" Icon="{ui:SymbolIcon QuestionCircle24}"
                                           TargetPageType="{x:Type views:HelpView}" />
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>
        </Border>

        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.RowSpan="2" />
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.RowSpan="2"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="420" />
    </Grid>
</ui:FluentWindow>
