<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Steam theme palette: restrained blue accents on dark blue-gray surfaces.
         Colors are defined as Color resources so other dictionaries (e.g. WpfUiBridge) can
         alias them with DynamicResource and update automatically when the theme is swapped. -->
    <Color x:Key="BgColor">#FF1B2838</Color>
    <Color x:Key="ChromeColor">#FF171A21</Color>
    <Color x:Key="SidebarColor">#FF171D25</Color>
    <Color x:Key="CardColor">#FF1E2B3C</Color>
    <Color x:Key="CardEdgeColor">#FF2A475E</Color>
    <Color x:Key="TileColor">#FF1B2838</Color>
    <Color x:Key="WellColor">#FF131B26</Color>
    <Color x:Key="PanelColor">#FF2A475E</Color>
    <Color x:Key="PanelHoverColor">#FF3D6586</Color>
    <Color x:Key="RowHoverColor">#FF2A3F5A</Color>

    <Color x:Key="AccentColor">#FF1A9FFF</Color>
    <Color x:Key="AccentHoverColor">#FF47BFFF</Color>
    <Color x:Key="AccentInkColor">#FF0B1620</Color>

    <Color x:Key="LinkColor">#FF66C0F4</Color>
    <Color x:Key="TextColor">#FFC6D4DF</Color>
    <Color x:Key="TextStrongColor">#FFF5F9FC</Color>
    <Color x:Key="MutedColor">#FF8F98A0</Color>
    <Color x:Key="DimColor">#FF556772</Color>

    <Color x:Key="ScrollThumbColor">#FF3D5870</Color>
    <Color x:Key="ScrollThumbHoverColor">#FF5B7A95</Color>

    <Color x:Key="GoodColor">#FF6EDC6E</Color>
    <Color x:Key="WarnColor">#FFFFC955</Color>
    <Color x:Key="BadColor">#FFFF716A</Color>

    <Color x:Key="OverlayFadeColor">#C8171D25</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardEdgeBrush" Color="{StaticResource CardEdgeColor}" />
    <SolidColorBrush x:Key="TileBrush" Color="{StaticResource TileColor}" />
    <SolidColorBrush x:Key="WellBrush" Color="{StaticResource WellColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelHoverBrush" Color="{StaticResource PanelHoverColor}" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />

    <SolidColorBrush x:Key="LinkBrush" Color="{StaticResource LinkColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextStrongBrush" Color="{StaticResource TextStrongColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimColor}" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />

    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />

    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
</ResourceDictionary>
