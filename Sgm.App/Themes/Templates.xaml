<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ============ Library row (list view) ============ -->
    <DataTemplate x:Key="GameRowTemplate">
        <Border Style="{StaticResource GameRow}" Margin="0,1">
            <Grid Height="{Binding DataContext.RowThumbHeight, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Edge" Grid.Column="0" Background="{DynamicResource LinkBrush}" />
                <Border Grid.Column="1" Margin="4,1,6,1"
                        Width="{Binding DataContext.RowThumbWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CornerRadius="3" Background="{DynamicResource PanelBrush}" ClipToBounds="True">
                    <Grid>
                        <ui:SymbolIcon Symbol="Image24" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Visibility="{Binding CoverImage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                        <Image Source="{Binding CoverImage, NotifyOnTargetUpdated=True}" Stretch="UniformToFill"
                               Style="{StaticResource FadeInImage}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding CoverImage, Converter={StaticResource NullToVis}}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="2,0,8,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"
                           FontSize="{Binding DataContext.RowFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                           Text="{Binding Name}" />

                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource LinkBrush}" TextTrimming="CharacterEllipsis"
                           Text="{Binding SourceLabel}" />

                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="10"
                           Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusText}" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <ui:Button x:Name="AddButton" Style="{StaticResource SgmIconButton}" Padding="0"
                            Width="{Binding DataContext.RowButtonHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Height="{Binding DataContext.RowButtonHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            ToolTip="Add to Steam"
                            AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                            Command="{Binding DataContext.AddSingleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                        <Grid>
                            <ui:SymbolIcon x:Name="AddGlyph" Symbol="Add24"
                                       Foreground="{DynamicResource AccentInkBrush}"
                                       Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ui:ProgressRing Width="12" Height="12" IsIndeterminate="True"
                                       Foreground="{DynamicResource AccentInkBrush}"
                                       Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ui:Button>
                    <ui:Button Style="{StaticResource SgmSubtleIconButton}" Padding="0" Margin="6,0,0,0"
                            Width="{Binding DataContext.RowButtonHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Height="{Binding DataContext.RowButtonHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            ToolTip="Match artwork"
                            AutomationProperties.Name="Match artwork"
                            Command="{Binding DataContext.MatchArtworkCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Image24"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource SgmDangerIconButton}" Padding="0" Margin="6,0,0,0"
                            Width="{Binding DataContext.RowButtonHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Height="{Binding DataContext.RowButtonHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            ToolTip="Hide game"
                            AutomationProperties.Name="Hide game"
                            Command="{Binding DataContext.HideCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding InSteam}" Value="True">
                <Setter TargetName="Edge" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                <Setter TargetName="AddGlyph" Property="Symbol" Value="Checkmark24" />
                <Setter TargetName="AddGlyph" Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
                <Setter TargetName="AddButton" Property="Opacity" Value="0.45" />
                <Setter TargetName="AddButton" Property="ToolTip" Value="Remove from Steam" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ Library tile (grid view) ============ -->
    <DataTemplate x:Key="GameTileTemplate">
        <Border Style="{StaticResource GameTile}" Margin="4">
            <StackPanel Margin="8">
                <Border Width="{Binding DataContext.TileCoverWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        Height="{Binding DataContext.TileCoverHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CornerRadius="6" Background="{DynamicResource PanelBrush}"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4"
                                          Direction="270" Opacity="0.55" RenderingBias="Performance" />
                    </Border.Effect>
                    <Border CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <ui:SymbolIcon Symbol="Image24" FontSize="34"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Visibility="{Binding CoverImage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                            <Image Source="{Binding CoverImage, NotifyOnTargetUpdated=True}" Stretch="UniformToFill"
                                   Style="{StaticResource FadeInImage}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding CoverImage, Converter={StaticResource NullToVis}}" />
                            <Border VerticalAlignment="Bottom" Height="88"
                                    Visibility="{Binding CoverImage, Converter={StaticResource NullToVis}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00171D25" Offset="0" />
                                        <GradientStop Color="#C8171D25" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                </Border>

                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center"
                           FontSize="{Binding DataContext.TileTitleFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                           Text="{Binding DisplayName}" />

                <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center"
                           FontSize="{Binding DataContext.TileMetaFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                           Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding StatusText, Mode=OneWay}" />
                    <Run Text=" &#x00B7; " />
                    <Run Text="{Binding SourceLabel, Mode=OneWay}" />
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <ui:Button x:Name="TileAddButton" Style="{StaticResource SgmIconButton}" Width="{Binding DataContext.TileButtonSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding DataContext.TileButtonSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Padding="0"
                            ToolTip="Add to Steam"
                            AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                            Command="{Binding DataContext.AddSingleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                        <Grid>
                            <ui:SymbolIcon x:Name="TileAddGlyph" Symbol="Add24" FontSize="{Binding DataContext.TileIconFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Foreground="{DynamicResource AccentInkBrush}"
                                       Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True"
                                       Foreground="{DynamicResource AccentInkBrush}"
                                       Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ui:Button>
                    <ui:Button Style="{StaticResource SgmSubtleIconButton}" Width="{Binding DataContext.TileButtonSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding DataContext.TileButtonSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="10,0,0,0" Padding="0"
                            ToolTip="Match artwork"
                            AutomationProperties.Name="Match artwork"
                            Command="{Binding DataContext.MatchArtworkCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Image24" FontSize="{Binding DataContext.TileIconFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource SgmDangerIconButton}" Width="{Binding DataContext.TileButtonSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding DataContext.TileButtonSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="10,0,0,0" Padding="0"
                            ToolTip="Hide game"
                            AutomationProperties.Name="Hide game"
                            Command="{Binding DataContext.HideCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="{Binding DataContext.TileIconFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}" />
                    </ui:Button>
                </StackPanel>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding InSteam}" Value="True">
                <Setter TargetName="TileAddGlyph" Property="Symbol" Value="Checkmark24" />
                <Setter TargetName="TileAddGlyph" Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
                <Setter TargetName="TileAddButton" Property="Opacity" Value="0.45" />
                <Setter TargetName="TileAddButton" Property="ToolTip" Value="Remove from Steam" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ Grid row strip (virtualizes rows of tiles) ============ -->
    <DataTemplate x:Key="GameRowStripTemplate">
        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource GameTileTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=ListBox}}" Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>

</ResourceDictionary>
