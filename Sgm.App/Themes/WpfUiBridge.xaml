<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Maps WPF-UI's Fluent theme keys onto this app's palette so any adopted WPF-UI control
         follows the Steam / Dark Gray themes instead of the stock Fluent appearance.
         Values are DynamicResource aliases to the Color resources declared in Palette.*.xaml,
         so they re-resolve automatically when ThemeService swaps the palette. -->

    <!-- ===== Application / layer / surface fills ===== -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{DynamicResource BgColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{DynamicResource BgColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{DynamicResource PanelColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{DynamicResource PanelHoverColor}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{DynamicResource WellColor}" />

    <!-- ===== Control fills ===== -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{DynamicResource PanelColor}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{DynamicResource PanelHoverColor}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="ControlOnImageFillColorDefaultBrush" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="ControlOnImageFillColorSecondaryBrush" Color="{DynamicResource PanelColor}" />
    <SolidColorBrush x:Key="ControlOnImageFillColorTertiaryBrush" Color="{DynamicResource PanelHoverColor}" />
    <SolidColorBrush x:Key="ControlOnImageFillColorDisabledBrush" Color="{DynamicResource WellColor}" />

    <!-- ===== Subtle / alt fills ===== -->
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{DynamicResource PanelHoverColor}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{DynamicResource PanelHoverColor}" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="{DynamicResource PanelColor}" />
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="{DynamicResource PanelHoverColor}" />
    <SolidColorBrush x:Key="ControlAltFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ControlAltFillColorDisabledBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="{DynamicResource OverlayFadeColor}" />

    <!-- ===== Control strokes / borders ===== -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorTertiaryBrush" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentTertiaryBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDisabledBrush" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="{DynamicResource MutedColor}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="{DynamicResource DimColor}" />

    <!-- ===== Surface / card / dialog borders ===== -->
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="{DynamicResource TextStrongColor}" />
    <Color x:Key="KeyboardFocusBorderColor">#FF1A9FFF</Color>
    <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="SeparatorBorderBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="SnackBarBorderBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="MenuBarItemBorderBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="MessageBoxSeparatorBorderBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="ProgressBarBorderBrush" Color="{DynamicResource CardEdgeColor}" />

    <!-- ===== Text ===== -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{DynamicResource TextStrongColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{DynamicResource MutedColor}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="{DynamicResource AccentInkColor}" />
    <Color x:Key="TextPlaceholderColor">#FF556772</Color>
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{DynamicResource AccentInkColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{DynamicResource AccentInkColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{DynamicResource AccentInkColor}" />

    <!-- ===== Accent ===== -->
    <Color x:Key="SystemAccentColor">#FF1A9FFF</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{DynamicResource LinkColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{DynamicResource LinkColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{DynamicResource LinkColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{DynamicResource AccentColor}" />

    <!-- ===== Progress ring ===== -->
    <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="ProgressRingBackgroundThemeBrush" Color="{DynamicResource CardEdgeColor}" />

    <!-- ===== Lists ===== -->
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{DynamicResource PanelColor}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{DynamicResource TextStrongColor}" />
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="{DynamicResource AccentColor}" />

    <!-- ===== System severity ===== -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{DynamicResource GoodColor}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{DynamicResource WarnColor}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{DynamicResource BadColor}" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="{DynamicResource MutedColor}" />
    <SolidColorBrush x:Key="SystemFillColorSolidNeutralBrush" Color="{DynamicResource MutedColor}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="SystemFillColorSolidNeutralBackgroundBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="SystemFillColorSolidAttentionBackgroundBrush" Color="{DynamicResource WellColor}" />

    <!-- ===== InfoBar ===== -->
    <SolidColorBrush x:Key="InfoBarBorderBrush" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityBorderBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="InfoBarSuccessSeverityBorderBrush" Color="{DynamicResource GoodColor}" />
    <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="InfoBarWarningSeverityBorderBrush" Color="{DynamicResource WarnColor}" />
    <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="InfoBarErrorSeverityBorderBrush" Color="{DynamicResource BadColor}" />

    <!-- ===== Text input (ui:TextBox / ui:PasswordBox) ===== -->
    <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource PanelColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="{DynamicResource MutedColor}" />

    <!-- ===== Cards (ui:Card / ui:CardControl / ui:CardAction) ===== -->
    <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="CardForeground" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="CardFooterBackground" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="CardBackgroundPointerOver" Color="{DynamicResource PanelColor}" />
    <SolidColorBrush x:Key="CardForegroundPointerOver" Color="{DynamicResource TextStrongColor}" />
    <SolidColorBrush x:Key="CardBackgroundPressed" Color="{DynamicResource PanelHoverColor}" />
    <SolidColorBrush x:Key="CardBorderBrushPressed" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="CardForegroundPressed" Color="{DynamicResource TextStrongColor}" />
    <SolidColorBrush x:Key="CardBackgroundDisabled" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="CardBorderBrushDisabled" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="CardForegroundDisabled" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{DynamicResource CardEdgeColor}" />

    <!-- ===== Buttons (ui:Button) ===== -->
    <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource TextStrongColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource PanelHoverColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource PanelHoverColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource CardEdgeColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource TextStrongColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{DynamicResource WellColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="{DynamicResource AccentInkColor}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{DynamicResource AccentInkColor}" />

    <!-- ===== Content dialog ===== -->
    <SolidColorBrush x:Key="ContentDialogForeground" Color="{DynamicResource TextStrongColor}" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="{DynamicResource PanelColor}" />
    <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="{DynamicResource OverlayFadeColor}" />

</ResourceDictionary>
