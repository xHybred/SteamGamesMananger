<UserControl x:Class="Sgm.App.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource PageTitle}" Text="Accounts" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"
                       Text="Choose which Steam accounts receive shortcuts and are used to detect what is already in Steam. The most recently used account is marked ★." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Style="{StaticResource SgmCard}" Margin="0,0,0,7" Padding="12,10">
                            <CheckBox Style="{StaticResource SgmCheckBox}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                <TextBlock Foreground="{DynamicResource TextBrush}" FontSize="13"
                                           Text="{Binding Display}" />
                            </CheckBox>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ui:Card Grid.Row="2" Style="{StaticResource SgmCard}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Remove system junk" />
                    <TextBlock Style="{StaticResource SmallMutedText}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Drops OS / UWP noise entries that were imported into the checked accounts." />
                </StackPanel>
                <ui:Button Grid.Column="1" Style="{StaticResource SgmSecondaryButton}" Height="34" VerticalAlignment="Center"
                           Content="Remove System Junk From Checked" Command="{Binding PruneCommand}" />
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
