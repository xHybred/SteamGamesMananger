<UserControl x:Class="Sgm.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Sgm.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="22,16,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="Non-Steam Games" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                           Text="{Binding SummaryText}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox Style="{StaticResource SgmSearchBox}" Width="220" VerticalAlignment="Center"
                            PlaceholderText="Search games..." ClearButtonEnabled="True"
                            Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ui:Button Style="{StaticResource SgmSecondaryButton}" Height="30" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon ArrowSync24}" Content="Scan Library"
                           Command="{Binding RescanCommand}" />
                <ui:Button Style="{StaticResource SgmGhostButton}" Height="30" Margin="4,0,0,0"
                           Content="Cancel" Command="{Binding CancelScanCommand}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <ui:Button Style="{StaticResource SgmPrimaryButton}" Height="30" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon Add24}" Content="Add All"
                           Command="{Binding AddAllNewCommand}" />

                <Rectangle Width="1" Fill="{DynamicResource CardEdgeBrush}" Opacity="0.5"
                           Margin="12,4,0,4" VerticalAlignment="Stretch" />

                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <!-- Ghost buttons stay flat when disabled instead of picking up WPF UI's Well fill. -->
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    </StackPanel.Resources>
                    <ui:Button Style="{StaticResource SgmGhostButton}" Padding="0" Width="28" Height="26"
                               ToolTip="Launch Steam"
                               Command="{Binding Shell.LaunchSteamCommand}">
                        <ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="{DynamicResource GoodBrush}" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource SgmGhostButton}" Padding="0" Width="28" Height="26" Margin="2,0,0,0"
                               ToolTip="Restart Steam"
                               Command="{Binding Shell.RestartSteamCommand}">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Foreground="{DynamicResource WarnBrush}" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource SgmGhostButton}" Padding="0" Width="28" Height="26" Margin="2,0,0,0"
                               ToolTip="Close Steam"
                               Command="{Binding Shell.CloseSteamCommand}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource BadBrush}" />
                    </ui:Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Toolbar: steam pill, view/density, flash -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource WellBrush}" CornerRadius="4"
                    Padding="10,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SteamRunning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource BadBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextBrush}" Text="{Binding SteamStatusText}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Border Background="{DynamicResource WellBrush}" CornerRadius="4" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="ViewMode"
                                     ToolTip="List view" IsChecked="{Binding IsListView, Mode=OneWay}"
                                     Command="{Binding SetListViewCommand}">
                            <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="12" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="ViewMode" Margin="2,0,0,0"
                                     ToolTip="Grid view" IsChecked="{Binding IsGridView, Mode=OneWay}"
                                     Command="{Binding SetGridViewCommand}">
                            <ui:SymbolIcon Symbol="Grid24" FontSize="12" />
                        </RadioButton>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource WellBrush}" CornerRadius="4" Padding="2" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Density"
                                     Content="Compact" IsChecked="{Binding IsCompactView, Mode=OneWay}"
                                     Command="{Binding SetCompactViewCommand}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Density" Margin="2,0,0,0"
                                     Content="Normal" IsChecked="{Binding IsNormalView, Mode=OneWay}"
                                     Command="{Binding SetNormalViewCommand}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Density" Margin="2,0,0,0"
                                     Content="Large" IsChecked="{Binding IsLargeView, Mode=OneWay}"
                                     Command="{Binding SetLargeViewCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>

        <!-- Launcher chips -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Chips}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton Style="{StaticResource ChipToggle}" Margin="0,0,6,6"
                                  IsChecked="{Binding IsOn, Mode=TwoWay}"
                                  Content="{Binding Display}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Games -->
        <Grid Grid.Row="3">
            <ui:ProgressRing Width="30" Height="30" IsIndeterminate="True"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <ListBox x:Name="ListGames" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameRowTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <ListBox x:Name="GridGames" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding GameRows}" ItemTemplate="{StaticResource GameRowStripTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Border Background="{DynamicResource WellBrush}" CornerRadius="8"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <ui:SymbolIcon Symbol="Library24" FontSize="40"
                               Foreground="{DynamicResource DimBrush}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" TextAlignment="Center"
                               Text="No games match the current filters.&#x0a;Press Scan Library or enable a launcher chip." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
