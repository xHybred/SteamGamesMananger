<ui:ContentDialog x:Class="Sgm.App.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Sgm.App.Views"
        Title="Update available"
        PrimaryButtonText="Install update"
        CloseButtonText="Later"
        DefaultButton="Primary"
        DialogMaxWidth="480"
        DialogWidth="460">

    <ui:ContentDialog.Style>
        <Style TargetType="{x:Type local:UpdateDialog}"
               BasedOn="{StaticResource {x:Type ui:ContentDialog}}" />
    </ui:ContentDialog.Style>

    <StackPanel>
        <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}"
                   TextWrapping="Wrap" LineHeight="19" />
        <ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,14,0,0"
                     Minimum="0" Maximum="100" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Style="{StaticResource SmallMutedText}"
                   Margin="0,6,0,0" Visibility="Collapsed" />
    </StackPanel>
</ui:ContentDialog>
